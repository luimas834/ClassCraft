# Copy this file to .env and change every value marked change-me.
# .env is never committed. The defaults here are safe for local development only.

# Database
POSTGRES_USER=classcraft
POSTGRES_PASSWORD=change-me
POSTGRES_DB=classcraft
DATABASE_URL=postgresql+psycopg://classcraft:change-me@db:5432/classcraft

# Sign-in. SECRET_KEY signs the JWT and must be at least 32 characters.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720
# true in production, so the cookie is sent only over HTTPS
COOKIE_SECURE=false

# The first committee account, created on first start. The password must be
# changed at first sign-in.
FIRST_ADMIN_EMAIL=committee@example.edu
FIRST_ADMIN_PASSWORD=change-me-now
FIRST_ADMIN_NAME=Routine Committee

# Time zone used to show dates. The database always stores UTC.
APP_TIMEZONE=Asia/Dhaka

# Data loaded into an empty database: none, demo or iut
SEED_DATA=demo

# Solver and worker
SOLVER_WORKERS=4
SOLVER_DEFAULT_TIME_LIMIT=60
SOLVER_MAX_TIME_LIMIT=600
WORKER_POLL_SECONDS=2

# Extra allowed origins. Empty because the web app and the API share one address.
CORS_ORIGINS=

LOG_LEVEL=info

# Production only. A domain name turns on automatic HTTPS.
SITE_ADDRESS=:80

# How many daily backups to keep
BACKUP_KEEP_DAYS=14
